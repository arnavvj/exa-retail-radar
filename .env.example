EXA_API_KEY=
# Optional: any public HTTPS URL (e.g. from https://play.svix.com) for the Monitor step
EXA_MONITOR_WEBHOOK_URL=
# Optional: Agent effort (minimal|low|medium|high|xhigh|auto). medium = $0.10 flat per run
EXA_AGENT_EFFORT=medium

# App login: add APP_USER<n>/APP_PASS<n> pairs (n = 1..9)
APP_USER1=
APP_PASS1=

# Optional: bring-your-own-agent copilot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
